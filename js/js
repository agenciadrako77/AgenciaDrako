document.addEventListener('DOMContentLoaded', function () {
 
    /* ---------------------------------------------------
       0. REINICIAR EL EFECTO DE ESCRITURA AL DAR CLIC EN "INICIO"
    --------------------------------------------------- */
 
    const heroTitleText = document.querySelector('.typewriter-text');
    const inicioLink = document.querySelector('.wf-pill a[href="#inicio"]');
 
    if (heroTitleText && inicioLink) {
        inicioLink.addEventListener('click', () => {
            heroTitleText.classList.remove('typewriter-text');
            void heroTitleText.offsetWidth;
            heroTitleText.classList.add('typewriter-text');
        });
    }
 
 
    /* ---------------------------------------------------
       1. FOTOS CON MOVIMIENTO (parallax)
    --------------------------------------------------- */
 
    const parallaxBlocks = document.querySelectorAll('.parallax-pair');
 
    if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    revealObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.25 });
 
        parallaxBlocks.forEach((block) => revealObserver.observe(block));
    } else {
        parallaxBlocks.forEach((block) => block.classList.add('in-view'));
    }
 
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 
    if (!prefersReducedMotion) {
        parallaxBlocks.forEach((block) => {
            const photos = block.querySelectorAll('.ph-photo[data-depth]');
 
            block.addEventListener('mousemove', (event) => {
                const rect = block.getBoundingClientRect();
                const offsetX = (event.clientX - rect.left) / rect.width - 0.5;
                const offsetY = (event.clientY - rect.top) / rect.height - 0.5;
 
                photos.forEach((photo) => {
                    const depth = parseFloat(photo.dataset.depth) || 0.2;
                    const moveX = offsetX * 40 * depth;
                    const moveY = offsetY * 40 * depth;
                    photo.style.transform = `translate(${moveX}px, ${moveY}px)`;
                });
            });
 
            block.addEventListener('mouseleave', () => {
                photos.forEach((photo) => {
                    photo.style.transform = 'translate(0, 0)';
                });
            });
        });
    }
 
 
    /* ---------------------------------------------------
       2. PROYECTOS — cambio de video por botón
    --------------------------------------------------- */
 
    const proyectoBtns  = document.querySelectorAll('.proyecto-btn');
    const proyectoPanel = document.querySelector('.proyecto-panel');
    const proyectoTitle = document.getElementById('proyecto-title');
    const proyectoText  = document.getElementById('proyecto-text');
    const proyectoVideos = document.querySelectorAll('.proyecto-video');
 
    if (proyectoVideos.length && proyectoPanel) {
 
        proyectoBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
 
                if (btn.classList.contains('is-active')) return;
 
                const targetProject = btn.dataset.project;
 
                proyectoBtns.forEach((b) => {
                    b.classList.remove('is-active');
                    b.setAttribute('aria-selected', 'false');
                });
                btn.classList.add('is-active');
                btn.setAttribute('aria-selected', 'true');
 
                proyectoVideos.forEach((video) => {
                    if (video.dataset.project === targetProject) {
                        video.classList.add('is-active');
                    } else {
                        video.classList.remove('is-active');
                        video.pause();
                    }
                });
 
                if (proyectoTitle) proyectoTitle.textContent = btn.dataset.title || '';
                if (proyectoText)  proyectoText.textContent  = btn.dataset.text  || '';
            });
        });
    }
 
 
    /* ---------------------------------------------------
       3. CINTA DE ROLES — movimiento automático y arrastre
       CORRECCIÓN: detecta si el usuario hizo clic real (sin
       mover el mouse) para no bloquear los links de PDF.
    --------------------------------------------------- */
 
    const rolesTrack   = document.getElementById('roles-track');
    const rolesMarquee = document.querySelector('.roles-marquee');
 
    if (rolesTrack && rolesMarquee) {
 
        const originalCards = Array.from(rolesTrack.children);
        originalCards.forEach((card) => {
            const clone = card.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            clone.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
            rolesTrack.appendChild(clone);
        });
 
        const SPEED = 230;
 
        let setWidth    = 0;
        let position    = 0;
        let isHovering  = false;
        let isDragging  = false;
        let dragStartX  = 0;
        let dragStartPos = 0;
        let lastTime    = null;
        let dragMoved   = false;   // ← NUEVO: saber si realmente se arrastró
 
        function measure() {
            setWidth = rolesTrack.scrollWidth / 2;
        }
 
        function wrap() {
            if (setWidth <= 0) return;
            position = position % setWidth;
            if (position > 0) position -= setWidth;
        }
 
        function applyTransform() {
            rolesTrack.style.transform = `translateX(${position}px)`;
        }
 
        function frame(time) {
            if (lastTime === null) lastTime = time;
            const dt = (time - lastTime) / 1000;
            lastTime = time;
 
            if (!isDragging && !isHovering) {
                position -= SPEED * dt;
                wrap();
                applyTransform();
            }
            requestAnimationFrame(frame);
        }
 
        function dragStart(clientX) {
            isDragging  = true;
            dragMoved   = false;
            dragStartX  = clientX;
            dragStartPos = position;
            rolesTrack.classList.add('is-dragging');
        }
 
        function dragMove(clientX) {
            if (!isDragging) return;
            const diff = clientX - dragStartX;
            // Solo se considera arrastre si movió más de 5px
            if (Math.abs(diff) > 5) {
                dragMoved = true;
                position  = dragStartPos + diff;
                wrap();
                applyTransform();
            }
        }
 
        function dragEnd(e) {
            if (!isDragging) return;
            isDragging = false;
            rolesTrack.classList.remove('is-dragging');
 
            // Si NO se movió (fue un clic real), dejar que el evento
            // llegue al link o botón que estaba debajo
            if (!dragMoved && e && e.target) {
                const link = e.target.closest('a');
                if (link && link.href) {
                    window.open(link.href, link.target || '_self');
                }
            }
        }
 
        measure();
        window.addEventListener('resize', measure);
 
        rolesMarquee.addEventListener('mouseenter', () => { isHovering = true; });
        rolesMarquee.addEventListener('mouseleave', () => { isHovering = false; });
        rolesMarquee.addEventListener('focusin',    () => { isHovering = true; });
        rolesMarquee.addEventListener('focusout',   () => { isHovering = false; });
 
        rolesMarquee.addEventListener('pointerdown', (e) => {
            // No iniciar arrastre si el clic fue directamente en un link
            if (e.target.closest('a')) return;
            dragStart(e.clientX);
            rolesMarquee.setPointerCapture(e.pointerId);
        });
        rolesMarquee.addEventListener('pointermove', (e) => dragMove(e.clientX));
        rolesMarquee.addEventListener('pointerup',     (e) => dragEnd(e));
        rolesMarquee.addEventListener('pointercancel', (e) => dragEnd(e));
 
        applyTransform();
 
        if (!prefersReducedMotion) {
            requestAnimationFrame(frame);
        }
    }
 
 
    /* ---------------------------------------------------
       4. SERVICIOS — tarjetas que se voltean
    --------------------------------------------------- */
 
    const servicioCards = document.querySelectorAll('.servicio-card');
 
    servicioCards.forEach((card) => {
        card.addEventListener('click', () => {
            card.classList.toggle('is-flipped');
        });
    });
 
});